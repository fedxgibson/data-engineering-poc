# Copy to .env (gitignored) and fill in. See domain/06-security.md.

# Anthropic API credential. Alternative: run `ant auth login` and leave this
# variable unset -- the SDK will use the active OAuth profile.
ANTHROPIC_API_KEY=

# Only needed if the key is "identity-linked" (tied to a user, not the org) --
# the API returns the exact error asking for it if needed. Format wrkspc_...,
# found in the Anthropic console, on the API key screen.
ANTHROPIC_WORKSPACE_ID=

# Token the API (api/main.py) requires in the X-API-Key header. Generate it with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=
